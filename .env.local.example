# Copy to .env.local (never commit that file) and fill in a Gmail app password:
# https://support.google.com/accounts/answer/185833
#
# Use URL-encoding for special characters in the app password.

MAILER_DSN=smtp://YOUR_GMAIL%40gmail.com:YOUR_APP_PASSWORD@smtp.gmail.com:587?encryption=tls
MAILER_SENDER=YOUR_GMAIL@gmail.com
DEFAULT_URI=http://127.0.0.1:8000
