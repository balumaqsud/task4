# Local overrides. Copy to .env.local and fill in real values.
# Do not commit .env.local.

# Gmail SMTP with an App Password (not your normal Gmail password).
# Encode @ in the username as %40. Strip spaces from the app password.
MAILER_DSN=gmail+smtp://you%40gmail.com:APP_PASSWORD@default
MAILER_SENDER=you@gmail.com

# Absolute origin used in confirmation links (worker has no HTTP request).
DEFAULT_URI=http://127.0.0.1:8000
