# Local overrides. Copy to .env.local and fill in real values.
# Do not commit .env.local.

# Resend HTTPS API (use this on Render; Gmail SMTP times out there).
# Dashboard: https://resend.com → API Keys → Create. From must be on a verified domain.
MAILER_DSN=resend+api://re_YOUR_API_KEY@default
MAILER_SENDER=noreply@your-verified-domain.com

# Absolute origin used in confirmation links.
DEFAULT_URI=http://127.0.0.1:8000
