{% extends 'base.html.twig' %}

{% block title %}Create account{% endblock %}

{% block body %}
    <main class="auth-page">
        <section class="auth-panel">
            <div class="auth-brand mb-5">THE APP</div>
            <div class="mb-4">
                <p class="auth-kicker mb-1">Start your journey</p>
                <h1 class="auth-heading mb-0">Create Your Account</h1>
            </div>

            {% include '_flashes.html.twig' %}

            {% if not form.vars.valid %}
                {% for error in form.vars.errors %}
                    <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>{{ error.message }}</span>
                    </div>
                {% endfor %}
                {% for child in form.children %}
                    {% for error in child.vars.errors %}
                        <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                            <span>{{ error.message }}</span>
                        </div>
                    {% endfor %}
                {% endfor %}
            {% endif %}

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
                {{ form_row(form.name, {'row_attr': {'class': 'mb-3'}, 'label_attr': {'class': 'form-label'}, 'attr': {'class': 'form-control form-control-lg', 'autocomplete': 'name'}}) }}
                {{ form_row(form.email, {'row_attr': {'class': 'mb-3'}, 'label_attr': {'class': 'form-label'}, 'attr': {'class': 'form-control form-control-lg', 'autocomplete': 'email'}}) }}
                {{ form_row(form.password, {'row_attr': {'class': 'mb-3'}, 'label_attr': {'class': 'form-label'}, 'attr': {'class': 'form-control form-control-lg', 'autocomplete': 'new-password'}}) }}
                {{ form_widget(form._token) }}
                {{ form_widget(form.submit, {'attr': {'class': 'btn btn-primary btn-lg w-100'}}) }}
            {{ form_end(form, {'render_rest': false}) }}

            <p class="auth-links mt-5 mb-0">Already have an account? <a href="{{ path('app_login') }}" class="link-primary">Sign in</a></p>
        </section>
        <div class="auth-image" role="img" aria-label="Blue geometric pattern"></div>
    </main>
{% endblock %}
