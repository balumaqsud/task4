{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <main class="auth-page">
        <section class="auth-panel">
            <div class="auth-brand mb-5">THE APP</div>
            <div class="mb-4">
                <p class="auth-kicker mb-1">Start your journey</p>
                <h1 class="auth-heading mb-0">Sign In to The App</h1>
            </div>

            {% include '_flashes.html.twig' %}

            {% if error %}
                <div class="alert alert-danger d-flex gap-2 align-items-start" role="alert">
                    <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                    <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" data-turbo="false">
                <div class="mb-3">
                    <label class="form-label small text-secondary" for="username">E-mail</label>
                    <div class="input-group">
                        <input class="form-control auth-input" id="username" type="email" name="_username" value="{{ last_username }}" autocomplete="email" required>
                        <span class="input-group-text bg-white border-start-0"><i class="bi bi-envelope-fill text-secondary" aria-hidden="true"></i></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-secondary" for="password">Password</label>
                    <input class="form-control auth-input" id="password" type="password" name="_password" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="btn btn-primary auth-submit w-100" type="submit" name="Login" value="Login">Sign In</button>
            </form>

            <div class="auth-links mt-5">
                <span>Don't have an account? <a href="{{ path('app_register') }}" class="link-primary">Sign up</a></span>
            </div>
        </section>
        <div class="auth-image" role="img" aria-label="Blue geometric pattern"></div>
    </main>
{% endblock %}
