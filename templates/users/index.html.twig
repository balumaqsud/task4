{% extends 'base.html.twig' %}

{% block body %}
    <nav class="navbar bg-white border-bottom">
        <div class="container page-shell">
            <a class="navbar-brand fw-semibold" href="{{ path('app_users') }}"><i class="bi bi-people-fill text-primary me-2" aria-hidden="true"></i>User management</a>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="btn btn-outline-secondary btn-sm" type="submit" title="Sign out" data-bs-toggle="tooltip" aria-label="Sign out"><i class="bi bi-box-arrow-right" aria-hidden="true"></i><span class="d-none d-sm-inline ms-2">Sign out</span></button>
            </form>
        </div>
    </nav>

    <main class="container page-shell py-4 py-md-5">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <p class="text-uppercase text-secondary small fw-semibold mb-1">Directory</p>
                <h1 class="h2 mb-1">Users</h1>
                <p class="text-secondary mb-0">Manage account access and status.</p>
            </div>
            <span class="badge text-bg-light border text-secondary px-3 py-2">{{ users|length }} users</span>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} d-flex gap-2 align-items-start" role="alert">
                    <i class="bi bi-{{ label == 'error' ? 'exclamation-circle' : 'check-circle' }}" aria-hidden="true"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        <form method="post" action="{{ path('app_users_actions') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('bulk_user_action') }}">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3" id="user-toolbar" aria-label="User actions">
                <button class="btn btn-outline-danger bulk-action" type="submit" name="action" value="block" disabled>Block</button>
                <button class="btn btn-outline-success bulk-action" type="submit" name="action" value="unblock" title="Unblock selected users" data-bs-toggle="tooltip" aria-label="Unblock selected users" disabled>
                    <i class="bi bi-unlock" aria-hidden="true"></i>
                </button>
                <button class="btn btn-outline-danger bulk-action" type="submit" name="action" value="delete" title="Delete selected users" data-bs-toggle="tooltip" aria-label="Delete selected users" disabled>
                    <i class="bi bi-trash" aria-hidden="true"></i>
                </button>
                <button class="btn btn-outline-warning bulk-action" type="submit" name="action" value="delete_unverified" title="Delete selected unverified users" data-bs-toggle="tooltip" aria-label="Delete selected unverified users" disabled>
                    <i class="bi bi-person-x" aria-hidden="true"></i>
                </button>
            </div>

            <div class="table-shell">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3"><input class="form-check-input" type="checkbox" id="select-all" title="Select all users" data-bs-toggle="tooltip" aria-label="Select all users"></th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Last login</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td class="ps-3"><input class="form-check-input user-selection" type="checkbox" name="ids[]" value="{{ user.id }}" aria-label="Select {{ user.name }}"></td>
                                <td class="fw-medium">{{ user.name }}</td>
                                <td class="text-secondary">{{ user.email }}</td>
                                <td class="text-secondary">{{ user.last_login_at ? user.last_login_at|date('M j, Y, g:i a') : 'Never' }}</td>
                                <td><span class="badge status-badge text-bg-{{ user.status == 'BLOCKED' ? 'danger' : (user.status == 'ACTIVE' ? 'success' : 'warning') }}">{{ user.status }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td class="text-center text-secondary py-5" colspan="5">No users found.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </form>
    </main>
{% endblock %}
