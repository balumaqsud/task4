{% extends 'base.html.twig' %}

{% block body %}
<div class="users-page">
    <nav class="navbar users-navbar">
        <div class="users-page-shell d-flex align-items-center justify-content-between">
            <a class="navbar-brand users-brand" href="{{ path('app_users') }}">THE APP</a>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button class="btn btn-outline-primary users-logout" type="submit">
                    <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Logout
                </button>
            </form>
        </div>
    </nav>

    <main class="users-page-shell users-main">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : 'success' }} d-flex gap-2 align-items-start" role="alert">
                    <i class="bi bi-{{ label == 'error' ? 'exclamation-circle' : 'check-circle' }}" aria-hidden="true"></i>
                    <span>{{ message }}</span>
                </div>
            {% endfor %}
        {% endfor %}

        <form method="post" action="{{ path('app_users_actions') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('bulk_user_action') }}">
            <div class="users-toolbar" id="user-toolbar" aria-label="User actions">
                <div class="users-toolbar-actions">
                    <button class="btn btn-outline-primary bulk-action toolbar-button toolbar-button-block" type="submit" name="action" value="block" disabled>
                        <i class="bi bi-lock-fill me-2" aria-hidden="true"></i>Block
                    </button>
                    <button class="btn btn-outline-primary bulk-action toolbar-button" type="submit" name="action" value="unblock" title="Unblock selected users" data-bs-toggle="tooltip" aria-label="Unblock selected users" disabled>
                        <i class="bi bi-unlock-fill" aria-hidden="true"></i>
                    </button>
                    <button class="btn btn-outline-danger bulk-action toolbar-button" type="submit" name="action" value="delete" title="Delete selected users" data-bs-toggle="tooltip" aria-label="Delete selected users" disabled>
                        <i class="bi bi-trash3-fill" aria-hidden="true"></i>
                    </button>
                    <button class="btn btn-outline-danger bulk-action toolbar-button" type="submit" name="action" value="delete_unverified" title="Delete selected unverified users" data-bs-toggle="tooltip" aria-label="Delete selected unverified users" disabled>
                        <i class="bi bi-eraser-fill" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="users-filter">
                    <label class="visually-hidden" for="user-filter">Filter users</label>
                    <input class="form-control" id="user-filter" type="search" placeholder="Filter" autocomplete="off">
                </div>
            </div>

            <div class="table-shell">
                <table class="table user-table align-middle">
                    <thead>
                        <tr>
                            <th scope="col" class="selection-column"><input class="form-check-input user-checkbox" type="checkbox" id="select-all" title="Select all users" data-bs-toggle="tooltip" aria-label="Select all users"></th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Last seen</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr data-user-row data-search-value="{{ (user.name ~ ' ' ~ user.email ~ ' ' ~ user.status)|lower }}" class="{{ user.status == 'BLOCKED' ? 'blocked-user' }}">
                                <td class="selection-column"><input class="form-check-input user-checkbox user-selection" type="checkbox" name="ids[]" value="{{ user.id }}" aria-label="Select {{ user.name }}"></td>
                                <td class="user-name">{{ user.name }}</td>
                                <td class="user-email">{{ user.email }}</td>
                                <td><span class="user-status">{{ user.status|lower|capitalize }}</span></td>
                                <td>
                                    {% if user.last_login_at %}
                                        <span class="last-seen" data-timestamp="{{ user.last_login_at|date('c') }}" title="{{ user.last_login_at|date('F j, Y H:i:s') }}" data-bs-toggle="tooltip">{{ user.last_login_at|date('M j, Y') }}</span>
                                    {% else %}
                                        <span class="last-seen">Never</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr id="no-users"><td class="empty-users" colspan="5">No users found.</td></tr>
                        {% endfor %}
                        <tr id="no-matching-users" hidden><td class="empty-users" colspan="5">No matching users.</td></tr>
                    </tbody>
                </table>
            </div>
        </form>
    </main>
</div>
{% endblock %}
